      "@/hooks/useStaff": ["./apps/web/src/modules/settings/hooks/useStaff.ts"],
      "@/hooks/useSupportTickets": ["./apps/web/src/modules/support/hooks/useSupportTickets.ts"],
      "@/hooks/useTransactionRules": ["./apps/web/src/modules/transactions/hooks/useTransactionRules.ts"],
      "@/hooks/useTransactions": ["./apps/web/src/modules/transactions/hooks/useTransactions.ts"],
      "@/contexts/*": ["./apps/web/src/shared/contexts/*"],
      "@/integrations/*": ["./apps/web/src/shared/integrations/*"],
      "@/lib/*": ["./apps/web/src/shared/lib/*"],
      "@/stores/*": ["./apps/web/src/shared/stores/*"],
      "@/*": ["./apps/web/src/*"]
    }
  },
  "include": ["apps/web/src"]
}
