{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitAny": false,
    "noFallthroughCasesInSwitch": false,
    "baseUrl": ".",
    "paths": {
      "@/components/shared": ["./apps/web/src/shared/components/index.ts"],
      "@/components/shared/*": ["./apps/web/src/shared/components/*"],
      "@/components/ui/*": ["./apps/web/src/shared/components/ui/*"],
      "@/components/layout/*": ["./apps/web/src/app/layout/*"],
      "@/components/providers/QuickBooksSyncProvider": ["./apps/web/src/modules/billing/providers/QuickBooksSyncProvider.tsx"],
      "@/components/admin/*": ["./apps/web/src/modules/admin/components/*"],
      "@/components/billing/*": ["./apps/web/src/modules/billing/components/*"],
      "@/components/calendar/*": ["./apps/web/src/modules/schedule/calendar/*"],
      "@/components/communications/*": ["./apps/web/src/modules/communications/components/*"],
      "@/components/customers/*": ["./apps/web/src/modules/crm/customers/components/*"],
      "@/components/dashboard/*": ["./apps/web/src/modules/dashboard/components/*"],
      "@/components/jobs/*": ["./apps/web/src/modules/jobs/components/*"],
      "@/components/leads/*": ["./apps/web/src/modules/crm/leads/components/*"],
      "@/components/payroll/*": ["./apps/web/src/modules/payroll/components/*"],
      "@/components/reports/*": ["./apps/web/src/modules/reports/components/*"],
      "@/components/schedule/*": ["./apps/web/src/modules/schedule/components/*"],
      "@/components/settings/*": ["./apps/web/src/modules/settings/components/*"],
      "@/components/support/*": ["./apps/web/src/modules/support/components/*"],
      "@/components/transactions/*": ["./apps/web/src/modules/transactions/components/*"],
      "@/hooks/use-toast": ["./apps/web/src/shared/hooks/use-toast.ts"],
      "@/hooks/*": ["./apps/web/src/modules/auth/hooks/*","./apps/web/src/modules/admin/hooks/*","./apps/web/src/modules/crm/customers/hooks/*","./apps/web/src/modules/crm/leads/hooks/*","./apps/web/src/modules/customers/hooks/*","./apps/web/src/modules/leads/hooks/*","./apps/web/src/modules/jobs/hooks/*","./apps/web/src/modules/communications/hooks/*","./apps/web/src/modules/billing/hooks/*","./apps/web/src/modules/transactions/hooks/*","./apps/web/src/modules/payroll/hooks/*","./apps/web/src/modules/settings/hooks/*","./apps/web/src/modules/support/hooks/*","./apps/web/src/shared/hooks/*"],
      "@/contexts/*": ["./apps/web/src/app/providers/*"],
      "@/integrations/*": ["./apps/web/src/app/infrastructure/*"],
      "@/lib/serviceEnums": ["./packages/contracts/serviceEnums.ts"],
      "@/lib/*": ["./apps/web/src/shared/lib/*"],
      "@/stores/permissions.store": ["./apps/web/src/modules/auth/stores/permissions.store.ts"],
      "@/stores/quickbooks.store": ["./apps/web/src/modules/billing/stores/quickbooks.store.ts"],
      "@/stores/types": ["./packages/types/core.ts"],
      "@/*": ["./apps/web/src/*"]
    }
  },
  "include": ["apps/web/src", "packages/contracts", "packages/types"]
}