{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitAny": false,
    "noFallthroughCasesInSwitch": false,
    "baseUrl": ".",
    "paths": {
      "@/components/shared": ["./apps/web/src/shared/components/index.ts"],
      "@/components/admin/*": ["./apps/web/src/modules/admin/components/*"],
      "@/components/billing/*": ["./apps/web/src/modules/billing/components/*"],
      "@/components/calendar/*": ["./apps/web/src/modules/schedule/calendar/*"],
      "@/components/communications/*": ["./apps/web/src/modules/communications/components/*"],
      "@/components/customers/*": ["./apps/web/src/modules/customers/components/*"],
      "@/components/dashboard/*": ["./apps/web/src/modules/dashboard/components/*"],
      "@/components/jobs/*": ["./apps/web/src/modules/jobs/components/*"],
      "@/components/layout/*": ["./apps/web/src/shared/layout/*"],
      "@/components/leads/*": ["./apps/web/src/modules/leads/components/*"],
      "@/components/payroll/*": ["./apps/web/src/modules/payroll/components/*"],
      "@/components/providers/*": ["./apps/web/src/shared/providers/*"],
      "@/components/reports/*": ["./apps/web/src/modules/reports/components/*"],
      "@/components/schedule/*": ["./apps/web/src/modules/schedule/components/*"],
      "@/components/settings/*": ["./apps/web/src/modules/settings/components/*"],
      "@/components/shared/*": ["./apps/web/src/shared/components/*"],
      "@/components/support/*": ["./apps/web/src/modules/support/components/*"],
      "@/components/transactions/*": ["./apps/web/src/modules/transactions/components/*"],
      "@/components/ui/*": ["./apps/web/src/shared/ui/*"],
      "@/hooks/use-toast": ["./apps/web/src/shared/hooks/use-toast.ts"],
      "@/hooks/useAddressAutocomplete": ["./apps/web/src/modules/customers/hooks/useAddressAutocomplete.ts"],
      "@/hooks/useAutomationConfigs": ["./apps/web/src/modules/settings/hooks/useAutomationConfigs.ts"],
      "@/hooks/useCompanyLanguage": ["./apps/web/src/modules/settings/hooks/useCompanyLanguage.ts"],
      "@/hooks/useCompanySettings": ["./apps/web/src/modules/settings/hooks/useCompanySettings.ts"],
      "@/hooks/useConversations": ["./apps/web/src/modules/communications/hooks/useConversations.ts"],
      "@/hooks/useCustomerRelationships": ["./apps/web/src/modules/customers/hooks/useCustomerRelationships.ts"],
      "@/hooks/useCustomerTerms": ["./apps/web/src/modules/customers/hooks/useCustomerTerms.ts"],
      "@/hooks/useCustomers": ["./apps/web/src/modules/customers/hooks/useCustomers.ts"],
      "@/hooks/useGoogle": ["./apps/web/src/modules/settings/hooks/useGoogle.ts"],
      "@/hooks/useGoogleCalendarSync": ["./apps/web/src/modules/settings/hooks/useGoogleCalendarSync.ts"],
      "@/hooks/useInvoices": ["./apps/web/src/modules/billing/hooks/useInvoices.ts"],
      "@/hooks/useJobGpsAlerts": ["./apps/web/src/modules/jobs/hooks/useJobGpsAlerts.ts"],
      "@/hooks/useJobStatusTracking": ["./apps/web/src/modules/jobs/hooks/useJobStatusTracking.ts"],
      "@/hooks/useJobs": ["./apps/web/src/modules/jobs/hooks/useJobs.ts"],
      "@/hooks/useLeads": ["./apps/web/src/modules/leads/hooks/useLeads.ts"],
      "@/hooks/useNotificationSound": ["./apps/web/src/modules/communications/hooks/useNotificationSound.ts"],
      "@/hooks/usePayrollRecords": ["./apps/web/src/modules/payroll/hooks/usePayrollRecords.ts"],
      "@/hooks/usePayrollRules": ["./apps/web/src/modules/payroll/hooks/usePayrollRules.ts"],
      "@/hooks/usePermission": ["./apps/web/src/modules/auth/hooks/usePermission.ts"],
      "@/hooks/usePlatformAdmin": ["./apps/web/src/modules/admin/hooks/usePlatformAdmin.ts"],
      "@/hooks/useQuickBooks": ["./apps/web/src/modules/billing/hooks/useQuickBooks.ts"],
      "@/hooks/useQuickBooksSync": ["./apps/web/src/modules/billing/hooks/useQuickBooksSync.ts"],
      "@/hooks/useRingCentral": ["./apps/web/src/modules/communications/hooks/useRingCentral.ts"],
      "@/hooks/useRingCentralSync": ["./apps/web/src/modules/communications/hooks/useRingCentralSync.ts"],
      "@/hooks/useSendEmail": ["./apps/web/src/modules/communications/hooks/useSendEmail.ts"],
